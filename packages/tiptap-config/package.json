{
  "name": "@costate-ai/tiptap-config",
  "version": "0.1.0",
  "description": "Shared Tiptap schema and markdown↔Y.js helpers for Costate frontend + Hocuspocus server. Single source of truth for the editor schema; round-trip fidelity is tested here.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/costate-ai/costate.git",
    "directory": "packages/tiptap-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./extensions": {
      "import": "./dist/extensions.js",
      "types": "./dist/extensions.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown.js",
      "types": "./dist/markdown.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hocuspocus/transformer": "^3.2.5",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "lowlight": "^3.3.0",
    "marked": "^15.0.0",
    "prosemirror-markdown": "^1.13.1",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
