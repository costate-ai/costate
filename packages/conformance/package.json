{
  "name": "@costate-ai/conformance",
  "version": "0.1.0-draft",
  "description": "Conformance test suite for the Costate protocol. Run against any Costate-conformant host to verify it implements the spec.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/costate-ai/costate.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/costate-ai/costate/blob/main/docs/Costate-RFC-v0.1.md",
  "keywords": [
    "costate",
    "conformance",
    "protocol",
    "test-suite",
    "ai-agents"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "costate-conformance": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
